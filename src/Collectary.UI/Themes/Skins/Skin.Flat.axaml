<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>
        <CornerRadius x:Key="ControlCornerRadius">0</CornerRadius>
        <CornerRadius x:Key="ControlCornerRadiusLarge">0</CornerRadius>
        <CornerRadius x:Key="CardCornerRadius">0</CornerRadius>
        <Thickness x:Key="ControlBorderThickness">1</Thickness>
        <Thickness x:Key="ControlPadding">12,7</Thickness>
        <x:Double x:Key="ControlHeight">32</x:Double>
        <x:Double x:Key="ControlFontSize">14</x:Double>
        <BoxShadows x:Key="CardShadow">0 0 0 0 #00000000</BoxShadows>
    </Styles.Resources>

    <StyleInclude Source="avares://Collectary.UI/Themes/Skins/Skin.Shared.axaml"/>
</Styles>
