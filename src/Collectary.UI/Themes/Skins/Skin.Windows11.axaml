<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>
        <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
        <CornerRadius x:Key="ControlCornerRadiusLarge">8</CornerRadius>
        <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
        <Thickness x:Key="ControlBorderThickness">1</Thickness>
        <Thickness x:Key="ControlPadding">12,7</Thickness>
        <x:Double x:Key="ControlHeight">34</x:Double>
        <x:Double x:Key="ControlFontSize">14</x:Double>
        <BoxShadows x:Key="CardShadow">0 1 3 0 #1A000000</BoxShadows>
    </Styles.Resources>

    <StyleInclude Source="avares://Collectary.UI/Themes/Skins/Skin.Shared.axaml"/>
</Styles>
