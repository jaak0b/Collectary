<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Collectary.UI.ViewModels"
             x:Class="Collectary.UI.Views.TimeFieldEditorView"
             x:DataType="vm:TimeFieldEditorViewModel">

    <StackPanel Spacing="4">
        <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock Text="{Binding Definition.Label}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       VerticalAlignment="Center"/>
            <TextBlock Text="*"
                       Foreground="Red"
                       IsVisible="{Binding Definition.IsRequired}"
                       VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="4">
            <NumericUpDown Value="{Binding Hour}"
                           Minimum="0"
                           Maximum="23"
                           FormatString="00"
                           Increment="1"
                           MinWidth="80"/>
            <TextBlock Text=":"
                       VerticalAlignment="Center"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <NumericUpDown Value="{Binding Minute}"
                           Minimum="0"
                           Maximum="59"
                           FormatString="00"
                           Increment="1"
                           MinWidth="80"/>
        </StackPanel>
    </StackPanel>
</UserControl>
