<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Collectary.UI.Controls"
             xmlns:vm="using:Collectary.Presentation.ViewModels"
             xmlns:loc="using:Collectary.Presentation.Localization"
             x:Class="Collectary.UI.Views.TimeFieldEditorView"
             x:DataType="vm:TimeFieldEditorViewModel">

    <controls:FieldEditorScaffold Label="{Binding Definition.Label}"
                                  IsRequired="{Binding Definition.IsRequired}"
                                  LabelAbove="{Binding LabelAbove}">
        <TextBox Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Classes.fieldError="{Binding HasError}"
                 PlaceholderText="{Binding [Time_Watermark], Source={x:Static loc:LocalizationService.Instance}}"
                 MinWidth="120"
                 MaxWidth="160"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top"/>
    </controls:FieldEditorScaffold>
</UserControl>
