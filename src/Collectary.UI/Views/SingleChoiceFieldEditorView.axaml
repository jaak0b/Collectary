<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Collectary.UI.Controls"
             xmlns:vm="using:Collectary.Presentation.ViewModels"
             x:Class="Collectary.UI.Views.SingleChoiceFieldEditorView"
             x:DataType="vm:SingleChoiceFieldEditorViewModel">

    <controls:FieldEditorScaffold Label="{Binding Definition.Label}"
                                  IsRequired="{Binding Definition.IsRequired}"
                                  LabelAbove="{Binding LabelAbove}">
        <ComboBox ItemsSource="{Binding Choices}"
                  SelectedItem="{Binding Selected}"
                  PlaceholderText="— select —"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Top"/>
    </controls:FieldEditorScaffold>
</UserControl>
