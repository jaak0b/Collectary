<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Collectary.UI.ViewModels"
             x:Class="Collectary.UI.Views.CmykColorFormatEditorView"
             x:DataType="vm:CmykColorFormatEditorViewModel">

    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Top">
        <StackPanel Spacing="2">
            <TextBlock Text=" " FontSize="11"/>
            <Border Width="40" Height="32" CornerRadius="4"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    Background="{Binding SwatchBrush}"/>
        </StackPanel>
        <StackPanel Spacing="2">
            <TextBlock Text="C %" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
            <NumericUpDown Value="{Binding C}" Minimum="0" Maximum="100" Increment="1" FormatString="0" Width="120"/>
        </StackPanel>
        <StackPanel Spacing="2">
            <TextBlock Text="M %" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
            <NumericUpDown Value="{Binding M}" Minimum="0" Maximum="100" Increment="1" FormatString="0" Width="120"/>
        </StackPanel>
        <StackPanel Spacing="2">
            <TextBlock Text="Y %" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
            <NumericUpDown Value="{Binding Y}" Minimum="0" Maximum="100" Increment="1" FormatString="0" Width="120"/>
        </StackPanel>
        <StackPanel Spacing="2">
            <TextBlock Text="K %" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
            <NumericUpDown Value="{Binding K}" Minimum="0" Maximum="100" Increment="1" FormatString="0" Width="120"/>
        </StackPanel>
    </StackPanel>
</UserControl>
