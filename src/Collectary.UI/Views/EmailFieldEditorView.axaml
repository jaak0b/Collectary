<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Collectary.UI.Controls"
             xmlns:vm="using:Collectary.Presentation.ViewModels"
             x:Class="Collectary.UI.Views.EmailFieldEditorView"
             x:DataType="vm:EmailFieldEditorViewModel">

    <controls:FieldEditorScaffold Label="{Binding Definition.Label}"
                                  IsRequired="{Binding Definition.IsRequired}"
                                  LabelAbove="{Binding LabelAbove}">
        <TextBox Text="{Binding Text}"
                 PlaceholderText="name@example.com"
                 VerticalAlignment="Top"/>
    </controls:FieldEditorScaffold>
</UserControl>
