<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Collectary.Presentation.ViewModels"
             xmlns:loc="using:Collectary.Presentation.Localization"
             xmlns:icons="using:Collectary.Core.Domain.Fields"
             xmlns:controls="using:Collectary.UI.Controls"
             x:Class="Collectary.UI.Views.MainView"
             x:DataType="vm:MainWindowViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.syncing">
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Style.Animations>
                <Animation Duration="0:0:1" IterationCount="Infinite">
                    <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>

    <Panel>

    <Grid RowDefinitions="48,*" IsVisible="{Binding IsAuthenticated}">

        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="4,0">

                <!-- Sidebar toggle -->
                <Button Grid.Column="0"
                        Command="{Binding ToggleSidebarCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="10,0"
                        ToolTip.Tip="{Binding [ToggleSidebar], Source={x:Static loc:LocalizationService.Instance}}"
                        VerticalAlignment="Center">
                    <TextBlock Text="{x:Static icons:IconGlyphs.Navigation}" Classes="icon" FontSize="18" Foreground="{DynamicResource TextPrimaryBrush}"/>
                </Button>

                <!-- Settings -->
                <Button Grid.Column="1"
                        Command="{Binding NavigateToSettingsCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="10,0"
                        ToolTip.Tip="{Binding [Settings], Source={x:Static loc:LocalizationService.Instance}}"
                        VerticalAlignment="Center">
                    <Path Data="{StaticResource SettingsGlyphGeometry}"
                          Fill="{DynamicResource TextPrimaryBrush}"
                          Width="17"
                          Height="17"
                          Stretch="Uniform"/>
                </Button>

                <controls:BreadcrumbBarPanel x:Name="BreadcrumbBar"
                                             Grid.Column="2"
                                             VerticalAlignment="Stretch"
                                             ClipToBounds="True"
                                             OverflowReservation="44"/>

                <StackPanel Grid.Column="3"
                            Orientation="Horizontal"
                            Spacing="4"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0">

                <Button Command="{Binding SwitchProfileCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="8,2"
                        ToolTip.Tip="{Binding [Profile_Switch], Source={x:Static loc:LocalizationService.Instance}}">
                    <TextBlock Text="{Binding CurrentProfileName}"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </Button>

                <Button x:Name="SyncStatusButton"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="8,4"
                        VerticalAlignment="Center"
                        IsVisible="{Binding Sync.IsConfigured}"
                        ToolTip.Tip="{Binding [Sync_Now], Source={x:Static loc:LocalizationService.Instance}}">
                    <Panel>
                        <TextBlock Text="{x:Static icons:IconGlyphs.ArrowSync}"
                                   Classes="icon"
                                   Classes.syncing="{Binding Sync.IsSyncing}"
                                   FontSize="16"
                                   RenderTransformOrigin="50%,50%"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <Ellipse Width="7" Height="7"
                                 Fill="{DynamicResource DangerBrush}"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Top"
                                 Margin="0,-2,-2,0"
                                 IsVisible="{Binding Sync.NeedsAttention}"/>
                    </Panel>
                </Button>

                </StackPanel>

            </Grid>
        </Border>

        <!-- Body: sidebar + content -->
        <Panel Grid.Row="1">

            <Grid x:Name="BodyGrid" RowDefinitions="*">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" MinWidth="180" MaxWidth="480"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sidebar (desktop only — hidden on narrow screens) -->
                <Border Grid.Column="0"
                        IsVisible="{Binding IsDesktopSidebarVisible}"
                        Background="{DynamicResource SidebarBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,1,0">
                    <ContentControl Content="{Binding SidebarViewModel}"/>
                </Border>

                <!-- Main content -->
                <ContentControl Grid.Column="1" Content="{Binding ContentViewModel}"/>

                <!-- Splitter overlays the sidebar/content seam so there is no empty gutter column -->
                <GridSplitter Grid.Column="1"
                              x:Name="SidebarSplitter"
                              Width="6"
                              HorizontalAlignment="Left"
                              Margin="-3,0,0,0"
                              IsVisible="{Binding IsDesktopSidebarVisible}"
                              Background="Transparent"
                              ResizeBehavior="PreviousAndCurrent"
                              ResizeDirection="Columns"/>

            </Grid>

            <!-- Mobile sidebar overlay (narrow screens only) -->
            <Grid IsVisible="{Binding IsMobileSidebarVisible}"
                  RowDefinitions="48,*"
                  ZIndex="10"
                  Background="{DynamicResource SidebarBackgroundBrush}">
                <Border Grid.Row="0"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*,Auto" Margin="8,0">
                        <TextBlock Grid.Column="0"
                                   Text="{Binding [MyCollections], Source={x:Static loc:LocalizationService.Instance}}"
                                   VerticalAlignment="Center"
                                   FontSize="14"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <Button Grid.Column="1"
                                Command="{Binding ToggleSidebarCommand}"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="10,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="✕" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Button>
                    </Grid>
                </Border>
                <ContentControl Grid.Row="1" Content="{Binding SidebarViewModel}"/>
            </Grid>

        </Panel>

    </Grid>

    <ContentControl Content="{Binding ProfilePicker}"
                    IsVisible="{Binding !IsAuthenticated}"/>

    <Border x:Name="DialogOverlay"
            ZIndex="100"
            Background="#80000000"
            IsVisible="{Binding DialogHost.HasActiveDialog, FallbackValue=False}">
        <ContentControl Content="{Binding DialogHost.ActiveDialog}"/>
    </Border>

    </Panel>
</UserControl>
