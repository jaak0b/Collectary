<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Collectary.Presentation.ViewModels"
             xmlns:loc="using:Collectary.Presentation.Localization"
             xmlns:icons="using:Collectary.Core.Domain.Fields"
             x:Class="Collectary.UI.Views.MainView"
             x:DataType="vm:MainWindowViewModel">

    <Panel>

    <Grid RowDefinitions="48,*" IsVisible="{Binding IsAuthenticated}">

        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="4,0">

                <!-- Sidebar toggle -->
                <Button Grid.Column="0"
                        Command="{Binding ToggleSidebarCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="10,0"
                        ToolTip.Tip="{Binding [ToggleSidebar], Source={x:Static loc:LocalizationService.Instance}}"
                        VerticalAlignment="Center">
                    <TextBlock Text="{x:Static icons:IconGlyphs.Navigation}" Classes="icon" FontSize="18" Foreground="{DynamicResource TextPrimaryBrush}"/>
                </Button>

                <!-- Settings -->
                <Button Grid.Column="1"
                        Command="{Binding NavigateToSettingsCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="10,0"
                        ToolTip.Tip="{Binding [Settings], Source={x:Static loc:LocalizationService.Instance}}"
                        VerticalAlignment="Center">
                    <Path Data="M19.14,12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94L14.4,2.81C14.36,2.57,14.16,2.4,13.92,2.4H10.08c-.24,0-.43.17-.47.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-.22-.08-.47,0-.59.22L2.74,8.87c-.12.21-.08.47.12.61l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s.02.64.07.94l-2.03,1.58c-.18.14-.23.41-.12.61l1.92,3.32c.12.22.37.29.59.22l2.39-.96c.5.38,1.03.7,1.62.94l.36,2.54c.05.24.24.41.48.41h3.84c.24,0,.44-.17.47-.41l.36-2.54c.59-.24,1.13-.56,1.62-.94l2.39.96c.22.08.47,0,.59-.22l1.92-3.32c.12-.22.07-.47-.12-.61L19.14,12.94zM12,15.6c-1.98,0-3.6-1.62-3.6-3.6s1.62-3.6,3.6-3.6,3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z"
                          Fill="{DynamicResource TextPrimaryBrush}"
                          Width="17"
                          Height="17"
                          Stretch="Uniform"/>
                </Button>

                <!-- Breadcrumb trail (root + optional collapsed dropdown + trimmed trailing crumbs) -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            ClipToBounds="True"
                            Spacing="0">

                    <Button Content="{Binding [MyCollections], Source={x:Static loc:LocalizationService.Instance}}"
                            Command="{Binding NavigateHomeCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="8,0"
                            FontWeight="Medium"
                            FontSize="14"
                            VerticalAlignment="Center"/>

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                IsVisible="{Binding HasCollapsedBreadcrumbs}">
                        <TextBlock Text="/"
                                   Margin="2,0"
                                   VerticalAlignment="Center"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <Button Content="{x:Static icons:IconGlyphs.MoreHorizontal}"
                                Classes="icon"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="6,0"
                                FontSize="14"
                                VerticalAlignment="Center">
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedLeft">
                                    <ItemsControl ItemsSource="{Binding CollapsedBreadcrumbs}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:BreadcrumbNode">
                                                <Button Content="{Binding Title}"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Padding="8,4"
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Left"
                                                        FontSize="14"
                                                        Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).NavigateToBreadcrumbCommand}"
                                                        CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding VisibleBreadcrumbs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:BreadcrumbNode">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="/"
                                               Margin="2,0"
                                               VerticalAlignment="Center"
                                               FontSize="14"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <Button Background="Transparent"
                                            BorderThickness="0"
                                            Padding="6,0"
                                            VerticalAlignment="Center"
                                            Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).NavigateToBreadcrumbCommand}"
                                            CommandParameter="{Binding}">
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="14"
                                                   MaxWidth="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).BreadcrumbMaxWidth}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                IsVisible="{Binding ActiveFieldEditor.HasCollapsedDrillBreadcrumbs, FallbackValue=False}">
                        <TextBlock Text="/"
                                   Margin="2,0"
                                   VerticalAlignment="Center"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <Button Content="{x:Static icons:IconGlyphs.MoreHorizontal}"
                                Classes="icon"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="6,0"
                                FontSize="14"
                                VerticalAlignment="Center">
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedLeft">
                                    <ItemsControl ItemsSource="{Binding ActiveFieldEditor.CollapsedDrillBreadcrumbs}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:EditorLevel">
                                                <Button Content="{Binding Title}"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Padding="8,4"
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Left"
                                                        FontSize="14"
                                                        Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).ActiveFieldEditor.NavigateToLevelCommand}"
                                                        CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding ActiveFieldEditor.VisibleDrillBreadcrumbs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:EditorLevel">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="/"
                                               Margin="2,0"
                                               VerticalAlignment="Center"
                                               FontSize="14"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <Button IsVisible="{Binding !IsCurrent}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="6,0"
                                            VerticalAlignment="Center"
                                            Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).ActiveFieldEditor.NavigateToLevelCommand}"
                                            CommandParameter="{Binding}">
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="14"
                                                   MaxWidth="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).ActiveFieldEditor.DrillBreadcrumbMaxWidth}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>
                                    </Button>
                                    <TextBlock Text="{Binding Title}"
                                               IsVisible="{Binding IsCurrent}"
                                               FontWeight="Medium"
                                               FontSize="14"
                                               Padding="6,0"
                                               MaxWidth="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).ActiveFieldEditor.DrillBreadcrumbMaxWidth}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>

                <!-- Sync indicator -->
                <StackPanel Grid.Column="3"
                            Orientation="Horizontal"
                            Spacing="6"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0"
                            IsVisible="{Binding Sync.IsConfigured}">
                    <Button Command="{Binding ResolveConflictsCommand}"
                            IsVisible="{Binding Sync.HasConflicts}"
                            Background="{DynamicResource DangerBrush}"
                            Foreground="{DynamicResource DangerForegroundBrush}"
                            Padding="8,4"
                            Content="{Binding [Sync_ResolveConflicts], Source={x:Static loc:LocalizationService.Instance}}"/>
                    <TextBlock Text="{Binding Sync.LastSyncText}"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <Button Command="{Binding Sync.SyncNowCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="8,4"
                            IsEnabled="{Binding !Sync.IsSyncing}"
                            ToolTip.Tip="{Binding [Sync_Now], Source={x:Static loc:LocalizationService.Instance}}">
                        <TextBlock Text="{x:Static icons:IconGlyphs.ArrowSync}" Classes="icon" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </Button>
                </StackPanel>

            </Grid>
        </Border>

        <!-- Body: sidebar + content -->
        <Panel Grid.Row="1">

            <Grid x:Name="BodyGrid" RowDefinitions="*">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" MinWidth="180" MaxWidth="480"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sidebar (desktop only — hidden on narrow screens) -->
                <Border Grid.Column="0"
                        IsVisible="{Binding IsDesktopSidebarVisible}"
                        Background="{DynamicResource SidebarBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,1,0">
                    <ContentControl Content="{Binding SidebarViewModel}"/>
                </Border>

                <!-- Splitter -->
                <GridSplitter Grid.Column="1"
                              x:Name="SidebarSplitter"
                              Width="4"
                              IsVisible="{Binding IsDesktopSidebarVisible}"
                              Background="Transparent"
                              ResizeBehavior="PreviousAndNext"
                              ResizeDirection="Columns"/>

                <!-- Main content -->
                <ContentControl Grid.Column="2" Content="{Binding ContentViewModel}"/>

            </Grid>

            <!-- Mobile sidebar overlay (narrow screens only) -->
            <Grid IsVisible="{Binding IsMobileSidebarVisible}"
                  RowDefinitions="48,*"
                  ZIndex="10"
                  Background="{DynamicResource SidebarBackgroundBrush}">
                <Border Grid.Row="0"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*,Auto" Margin="8,0">
                        <TextBlock Grid.Column="0"
                                   Text="{Binding [MyCollections], Source={x:Static loc:LocalizationService.Instance}}"
                                   VerticalAlignment="Center"
                                   FontSize="14"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <Button Grid.Column="1"
                                Command="{Binding ToggleSidebarCommand}"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="10,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="✕" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Button>
                    </Grid>
                </Border>
                <ContentControl Grid.Row="1" Content="{Binding SidebarViewModel}"/>
            </Grid>

        </Panel>

    </Grid>

    <ContentControl Content="{Binding Login}"
                    IsVisible="{Binding !IsAuthenticated}"/>

    </Panel>
</UserControl>
