<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Collectary.UI.Controls"
             xmlns:vm="using:Collectary.Presentation.ViewModels"
             xmlns:loc="using:Collectary.Presentation.Localization"
             x:Class="Collectary.UI.Views.AudioFieldEditorView"
             x:DataType="vm:AudioFieldEditorViewModel">

    <controls:FieldEditorScaffold Label="{Binding Definition.Label}"
                                  IsRequired="{Binding Definition.IsRequired}"
                                  LabelAbove="{Binding LabelAbove}">
        <StackPanel Spacing="6" VerticalAlignment="Top">
            <StackPanel Orientation="Horizontal" Spacing="6"
                        IsVisible="{Binding AudioAvailable}">
                <Button Command="{Binding ToggleRecordCommand}"
                        ToolTip.Tip="{Binding RecordTooltip}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding RecordButtonIcon}"
                                   Classes="icon"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding RecordButtonLabel}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding TogglePlaybackCommand}"
                        IsEnabled="{Binding HasAudio}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding PlayButtonIcon}"
                                   Classes="icon"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding PlayButtonLabel}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <TextBlock Text="{Binding DurationSeconds, StringFormat={}{0}s}"
                           VerticalAlignment="Center"
                           IsVisible="{Binding HasAudio, FallbackValue=False}"/>
                <Button Command="{Binding OpenSettingsCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="6,2"
                        VerticalAlignment="Center"
                        ToolTip.Tip="{Binding [Settings], Source={x:Static loc:LocalizationService.Instance}}">
                    <Path Data="{StaticResource SettingsGlyphGeometry}"
                          Fill="{DynamicResource TextSecondaryBrush}"
                          Width="15"
                          Height="15"
                          Stretch="Uniform"/>
                </Button>
            </StackPanel>
            <TextBlock Text="{Binding [Audio_Unavailable], Source={x:Static loc:LocalizationService.Instance}}"
                       TextWrapping="Wrap"
                       Opacity="0.7"
                       IsVisible="{Binding !AudioAvailable}"/>
            <TextBlock Text="{Binding ErrorMessage}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource DangerBrush}"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        </StackPanel>
    </controls:FieldEditorScaffold>
</UserControl>
