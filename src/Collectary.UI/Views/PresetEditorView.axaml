<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Collectary.Presentation.ViewModels"
             xmlns:sf="using:Collectary.Presentation.ViewModels.SharedFields"
             xmlns:loc="using:Collectary.Presentation.Localization"
             xmlns:converters="using:Collectary.Presentation.Converters"
             xmlns:controls="using:Collectary.UI.Controls"
             xmlns:icons="using:Collectary.Core.Domain.Fields"
             x:Class="Collectary.UI.Views.PresetEditorView"
             x:DataType="vm:PresetEditorViewModel">

    <UserControl.Styles>
        <Style Selector="Border.dragging">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BoxShadow" Value="0 6 16 0 #50000000"/>
            <Setter Property="ZIndex" Value="1"/>
            <Setter Property="RenderTransform" Value="scale(1.01)"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Margin="16">

        <!-- Header form — hidden when drilled into a sub-list or when narrow with a field selected -->
        <Grid Grid.Row="0" x:Name="CollectionSettingsHeader" ColumnDefinitions="*,*,Auto,Auto" ColumnSpacing="8" Margin="0,0,0,8"
              IsVisible="{Binding IsHeaderVisible}">
            <TextBox Grid.Column="0"
                     Text="{Binding Name}"
                     PlaceholderText="{Binding [Name], Source={x:Static loc:LocalizationService.Instance}}"/>
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding AvailableParents}"
                      SelectedItem="{Binding SelectedParent}"
                      HorizontalAlignment="Stretch"
                      PlaceholderText="{Binding [NoneOption], Source={x:Static loc:LocalizationService.Instance}}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <controls:SafeNumericUpDown Grid.Column="2"
                           Value="{Binding ColumnCount}"
                           Minimum="1"
                           Maximum="24"
                           Increment="1"
                           FormatString="0"
                           ToolTip.Tip="{Binding [ColumnCount], Source={x:Static loc:LocalizationService.Instance}}"
                           MinWidth="72"/>
            <ComboBox Grid.Column="3"
                      ItemsSource="{Binding FieldLabelLayoutOptions}"
                      SelectedItem="{Binding SelectedFieldLabelLayout}"
                      DisplayMemberBinding="{Binding Display}"
                      ToolTip.Tip="{Binding [FieldLabel_Layout], Source={x:Static loc:LocalizationService.Instance}}"
                      MinWidth="140"/>
        </Grid>

        <!-- Master / detail split -->
        <Grid x:Name="SplitGrid" Grid.Row="1" RowDefinitions="*" ColumnDefinitions="2*,Auto,3*" Margin="0,8,0,0">

            <!-- Master: field list + add -->
            <Grid x:Name="MasterPane" Grid.Column="0" MinWidth="200" RowDefinitions="*,Auto"
                  IsVisible="{Binding IsMasterPanelVisible}">
                <Border Grid.Row="0"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                    <ListBox ItemsSource="{Binding CurrentRows}"
                             SelectedItem="{Binding SelectedNode}"
                             Background="Transparent"
                             x:Name="FieldListBox">
                        <ListBox.DataTemplates>
                            <DataTemplate DataType="vm:FieldDefinitionRowViewModel">
                                <Border Background="Transparent" Classes.dragging="{Binding IsDragging}">
                                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto">
                                    <TextBlock Grid.Column="0"
                                               Text="{x:Static icons:IconGlyphs.ReOrderDotsVertical}" Classes="icon"
                                               Tag="DragHandle"
                                               Background="Transparent"
                                               Cursor="SizeAll"
                                               IsVisible="{Binding CanDelete}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding TypeIcon}"
                                               Classes="icon"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <Grid Grid.Column="2" ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                                        <TextBlock Grid.Column="0" Text="{Binding LockGlyph}" Classes="icon"
                                                   VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding DisplayLabel}"
                                                   FontWeight="Medium"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Grid.Column="3"
                                               Text="●"
                                               FontSize="10"
                                               ToolTip.Tip="{Binding [Required], Source={x:Static loc:LocalizationService.Instance}}"
                                               IsVisible="{Binding IsRequired}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"
                                               Margin="4,0"/>
                                    <TextBlock Grid.Column="4"
                                               Text="{x:Static icons:IconGlyphs.ChevronRight}" Classes="icon"
                                               FontSize="16"
                                               IsVisible="{Binding IsDrillable}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"
                                               Margin="4,0"/>
                                    <Button Grid.Column="5"
                                            Content="{x:Static icons:IconGlyphs.Dismiss}" Classes="icon"
                                            IsVisible="{Binding CanDelete}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="6,2"
                                            Command="{Binding $parent[ListBox].((vm:PresetEditorViewModel)DataContext).RemoveFieldCommand}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                                </Border>
                            </DataTemplate>

                            <DataTemplate DataType="vm:FieldGroupRowViewModel">
                                <Border Background="Transparent" Classes.dragging="{Binding IsDragging}">
                                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                                    <TextBlock Grid.Column="0"
                                               Text="{x:Static icons:IconGlyphs.ReOrderDotsVertical}" Classes="icon"
                                               Tag="DragHandle"
                                               Background="Transparent"
                                               Cursor="SizeAll"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding TypeIcon}"
                                               Classes="icon"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding DisplayLabel}"
                                               FontWeight="Medium"
                                               FontStyle="Italic"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3"
                                               Text="{x:Static icons:IconGlyphs.ChevronRight}" Classes="icon"
                                               FontSize="16"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"
                                               Margin="4,0"/>
                                    <Button Grid.Column="4"
                                            Content="{x:Static icons:IconGlyphs.Dismiss}" Classes="icon"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="6,2"
                                            Command="{Binding $parent[ListBox].((vm:PresetEditorViewModel)DataContext).RemoveFieldCommand}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.DataTemplates>
                    </ListBox>
                </Border>

                <Button Grid.Row="1"
                        x:Name="AddFieldButton"
                        Content="{Binding [AddField], Source={x:Static loc:LocalizationService.Instance}}"
                        Padding="12,6"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Margin="0,8,0,0">
                    <Button.Flyout>
                        <MenuFlyout/>
                    </Button.Flyout>
                </Button>
            </Grid>

            <!-- Resizer -->
            <GridSplitter x:Name="PaneSplitter"
                          Grid.Column="1"
                          Width="6"
                          Margin="3,0"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          Background="{DynamicResource BorderBrush}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Cursor="SizeWestEast"/>

            <!-- Detail: selected node config -->
            <Border x:Name="DetailPane"
                    Grid.Column="2"
                    MinWidth="280"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="16,16,10,16"
                    IsVisible="{Binding IsDetailPanelVisible}">

                <Grid RowDefinitions="Auto,*">

                <!-- Mobile back button -->
                <Button Grid.Row="0"
                        IsVisible="{Binding IsNarrow}"
                        Command="{Binding MobileNavigateBackCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="←" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding [Back], Source={x:Static loc:LocalizationService.Instance}}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                </Button>

                <Panel Grid.Row="1">

                <!-- Empty state -->
                <TextBlock Text="{Binding [SelectFieldHint], Source={x:Static loc:LocalizationService.Instance}}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           IsVisible="{Binding SelectedNode, Converter={x:Static ObjectConverters.IsNull}}"/>

                <!-- System field read-only notice -->
                <StackPanel IsVisible="{Binding SelectedFieldRow.IsSharedField, FallbackValue=False}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Spacing="8"
                            Margin="16">
                    <TextBlock Text="{x:Static icons:IconGlyphs.LockClosed}"
                               Classes="icon"
                               FontSize="32"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding [EditInSharedFields], Source={x:Static loc:LocalizationService.Instance}}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"/>

                    <StackPanel Spacing="4"
                                MinWidth="200"
                                IsVisible="{Binding SelectedFieldRow.HasAvailableGroups, FallbackValue=False}">
                        <TextBlock Text="{Binding [Group], Source={x:Static loc:LocalizationService.Instance}}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="12"/>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{Binding SelectedFieldRow.AvailableGroups}"
                                      SelectedItem="{Binding SelectedFieldRow.SelectedGroup}"
                                      HorizontalAlignment="Stretch"
                                      PlaceholderText="{Binding [Ungrouped], Source={x:Static loc:LocalizationService.Instance}}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FieldGroupRowViewModel">
                                        <TextBlock Text="{Binding Name}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Column="1"
                                    Content="{x:Static icons:IconGlyphs.Dismiss}" Classes="icon"
                                    Padding="6,2"
                                    Command="{Binding SelectedFieldRow.ClearGroupCommand}"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>

                <!-- Field config -->
                <controls:FieldDetailEditor DataContext="{Binding SelectedFieldRow}"
                                            IsVisible="{Binding $parent[UserControl].((vm:PresetEditorViewModel)DataContext).SelectedFieldRow.IsEditable, FallbackValue=False}"
                                            DrillCommand="{Binding $parent[UserControl].((vm:PresetEditorViewModel)DataContext).DrillIntoCommand}"/>

                <!-- Group config -->
                <controls:GroupDetailEditor DataContext="{Binding SelectedGroupRow}"
                                            IsVisible="{Binding $parent[UserControl].((vm:PresetEditorViewModel)DataContext).SelectedGroupRow, Converter={x:Static ObjectConverters.IsNotNull}}"
                                            DrillCommand="{Binding $parent[UserControl].((vm:PresetEditorViewModel)DataContext).DrillIntoCommand}"/>
                </Panel>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer actions -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="0,16,0,0">
            <Button Command="{Binding SaveCommand}"
                    Content="{Binding [Save], Source={x:Static loc:LocalizationService.Instance}}"
                    Padding="12,6"/>
            <Button Command="{Binding SaveAndGoBackCommand}"
                    Content="{Binding [SaveAndGoBack], Source={x:Static loc:LocalizationService.Instance}}"
                    Background="{DynamicResource PrimaryBrush}"
                    Foreground="{DynamicResource PrimaryForegroundBrush}"
                    Padding="16,6"/>
            <Button Command="{Binding CancelCommand}"
                    Content="{Binding [Cancel], Source={x:Static loc:LocalizationService.Instance}}"
                    Padding="12,6"/>
        </StackPanel>

    </Grid>
</UserControl>
