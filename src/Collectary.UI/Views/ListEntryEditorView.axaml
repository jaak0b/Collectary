<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Collectary.Presentation.ViewModels"
             xmlns:loc="using:Collectary.Presentation.Localization"
             xmlns:controls="using:Collectary.UI.Controls"
             x:Class="Collectary.UI.Views.ListEntryEditorView"
             x:DataType="vm:ListEntryEditorViewModel">

    <ScrollViewer>
        <StackPanel Spacing="12" Margin="16">

            <TextBlock Text="{Binding EntryLabel}"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>

            <controls:GroupedFieldsView/>

            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="Red"
                       TextWrapping="Wrap"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,16,0,0">
                <Button x:Name="BackButton"
                        Command="{Binding BackCommand}"
                        Background="{DynamicResource PrimaryBrush}"
                        Foreground="{DynamicResource PrimaryForegroundBrush}"
                        Padding="16,6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="←" FontSize="16"/>
                        <TextBlock Text="{Binding [SaveAndBack], Source={x:Static loc:LocalizationService.Instance}}"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding SaveCommand}"
                        Content="{Binding [Save], Source={x:Static loc:LocalizationService.Instance}}"
                        Padding="12,6"/>
                <Button Command="{Binding GoBackCommand}"
                        Content="{Binding [Cancel], Source={x:Static loc:LocalizationService.Instance}}"
                        Padding="12,6"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
