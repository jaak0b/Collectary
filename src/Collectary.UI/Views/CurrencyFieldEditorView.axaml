<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Collectary.UI.ViewModels"
             x:Class="Collectary.UI.Views.CurrencyFieldEditorView"
             x:DataType="vm:CurrencyFieldEditorViewModel">

    <StackPanel Spacing="4">
        <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock Text="{Binding Definition.Label}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       VerticalAlignment="Center"/>
            <TextBlock Text="*"
                       Foreground="Red"
                       IsVisible="{Binding Definition.IsRequired}"
                       VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="{Binding CurrencySymbol}"
                       VerticalAlignment="Center"
                       FontWeight="Medium"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <NumericUpDown Value="{Binding Amount}"
                           Minimum="0"
                           Maximum="999999999"
                           FormatString="0.00"
                           Increment="0.01"
                           MinWidth="140"
                           HorizontalAlignment="Left"/>
        </StackPanel>
    </StackPanel>
</UserControl>
