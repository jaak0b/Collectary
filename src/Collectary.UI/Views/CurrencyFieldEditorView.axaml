<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Collectary.UI.Controls"
             xmlns:vm="using:Collectary.Presentation.ViewModels"
             x:Class="Collectary.UI.Views.CurrencyFieldEditorView"
             x:DataType="vm:CurrencyFieldEditorViewModel">

    <controls:FieldEditorScaffold Label="{Binding Definition.Label}"
                                  IsRequired="{Binding Definition.IsRequired}"
                                  LabelAbove="{Binding LabelAbove}">
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
            <TextBlock Text="{Binding CurrencySymbol}"
                       VerticalAlignment="Center"
                       FontWeight="Medium"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <controls:SafeNumericUpDown Value="{Binding Amount}"
                           Minimum="0"
                           Maximum="999999999"
                           FormatString="0.00"
                           Increment="0.01"
                           MinWidth="140"
                           HorizontalAlignment="Left"/>
        </StackPanel>
    </controls:FieldEditorScaffold>
</UserControl>
