<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Collectary.UI.Controls"
             xmlns:vm="using:Collectary.Presentation.ViewModels"
             x:Class="Collectary.UI.Views.CurrencyFieldEditorView"
             x:DataType="vm:CurrencyFieldEditorViewModel">

    <controls:FieldEditorScaffold Label="{Binding Definition.Label}"
                                  IsRequired="{Binding Definition.IsRequired}"
                                  LabelAbove="{Binding LabelAbove}">
        <Border HorizontalAlignment="Left" VerticalAlignment="Top" MinWidth="160"
                Classes="input-shell"
                Background="{DynamicResource SurfaceAltBrush}"
                BorderThickness="{DynamicResource ControlBorderThickness}"
                CornerRadius="{DynamicResource ControlCornerRadius}"
                MinHeight="{DynamicResource ControlHeight}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding CurrencySymbol}"
                           Margin="10,0,2,0"
                           VerticalAlignment="Center"
                           FontWeight="Medium"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <controls:SafeNumericUpDown Value="{Binding Amount}"
                               Minimum="0"
                               Maximum="999999999"
                               FormatString="0.00"
                               Increment="0.01"
                               ShowButtonSpinner="False"
                               Background="Transparent"
                               BorderThickness="0"
                               VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </controls:FieldEditorScaffold>
</UserControl>
