<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Collectary.UI.Controls"
             xmlns:vm="using:Collectary.Presentation.ViewModels"
             x:Class="Collectary.UI.Views.CurrencyFieldEditorView"
             x:DataType="vm:CurrencyFieldEditorViewModel">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" SharedSizeGroup="FieldLabel"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4"
                    VerticalAlignment="Top" Margin="0,4,16,0">
            <TextBlock Text="{Binding Definition.Label}"
                       MaxWidth="160" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBlock Text="*"
                       Foreground="Red"
                       IsVisible="{Binding Definition.IsRequired}"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
            <TextBlock Text="{Binding CurrencySymbol}"
                       VerticalAlignment="Center"
                       FontWeight="Medium"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <controls:SafeNumericUpDown Value="{Binding Amount}"
                           Minimum="0"
                           Maximum="999999999"
                           FormatString="0.00"
                           Increment="0.01"
                           MinWidth="140"
                           HorizontalAlignment="Left"/>
        </StackPanel>
    </Grid>
</UserControl>
