<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Collectary.UI.ViewModels"
             x:Class="Collectary.UI.Views.TextFieldEditorView"
             x:DataType="vm:TextFieldEditorViewModel">

    <StackPanel Spacing="4">
        <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock Text="{Binding Definition.Label}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       VerticalAlignment="Center"/>
            <TextBlock Text="*"
                       Foreground="Red"
                       IsVisible="{Binding Definition.IsRequired}"
                       VerticalAlignment="Center"/>
        </StackPanel>
        <TextBox Text="{Binding Text}" PlaceholderText="{Binding Definition.Label}"/>
    </StackPanel>
</UserControl>
