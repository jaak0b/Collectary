<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Collectary.UI.Controls"
             xmlns:vm="using:Collectary.Presentation.ViewModels"
             x:Class="Collectary.UI.Views.RatingFieldEditorView"
             x:DataType="vm:RatingFieldEditorViewModel">

    <controls:FieldEditorScaffold Label="{Binding Definition.Label}"
                                  IsRequired="{Binding Definition.IsRequired}"
                                  LabelAbove="{Binding LabelAbove}">
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Top">
            <Slider Minimum="0"
                    Maximum="{Binding MaxStars}"
                    Value="{Binding Stars}"
                    TickFrequency="1"
                    IsSnapToTickEnabled="True"
                    Width="160"
                    VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Stars}"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       VerticalAlignment="Center"
                       MinWidth="16"/>
        </StackPanel>
    </controls:FieldEditorScaffold>
</UserControl>
