<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Collectary.UI.ViewModels"
             x:Class="Collectary.UI.Views.RgbColorFormatEditorView"
             x:DataType="vm:RgbColorFormatEditorViewModel">

    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Top">
        <StackPanel Spacing="2">
            <TextBlock Text=" " FontSize="11"/>
            <ColorPicker Color="{Binding PickerColor, Mode=TwoWay}"/>
        </StackPanel>
        <StackPanel Spacing="2">
            <TextBlock Text="R" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
            <NumericUpDown Value="{Binding R}" Minimum="0" Maximum="255" Increment="1" FormatString="0" Width="120"/>
        </StackPanel>
        <StackPanel Spacing="2">
            <TextBlock Text="G" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
            <NumericUpDown Value="{Binding G}" Minimum="0" Maximum="255" Increment="1" FormatString="0" Width="120"/>
        </StackPanel>
        <StackPanel Spacing="2">
            <TextBlock Text="B" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
            <NumericUpDown Value="{Binding B}" Minimum="0" Maximum="255" Increment="1" FormatString="0" Width="120"/>
        </StackPanel>
    </StackPanel>
</UserControl>
