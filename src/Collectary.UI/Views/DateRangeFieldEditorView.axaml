<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Collectary.UI.Controls"
             xmlns:vm="using:Collectary.Presentation.ViewModels"
             xmlns:loc="using:Collectary.Presentation.Localization"
             x:Class="Collectary.UI.Views.DateRangeFieldEditorView"
             x:DataType="vm:DateRangeFieldEditorViewModel">

    <controls:FieldEditorScaffold Label="{Binding Definition.Label}"
                                  IsRequired="{Binding Definition.IsRequired}"
                                  LabelAbove="{Binding LabelAbove}">
        <controls:DatePickerBox IsRange="True"
                                From="{Binding From, Mode=TwoWay}"
                                To="{Binding To, Mode=TwoWay}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                MinWidth="240"/>
    </controls:FieldEditorScaffold>
</UserControl>
