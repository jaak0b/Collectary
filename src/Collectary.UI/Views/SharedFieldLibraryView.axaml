<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="using:Collectary.Core.Domain.Fields"
             xmlns:vm="using:Collectary.Presentation.ViewModels"
             xmlns:sf="using:Collectary.Presentation.ViewModels.SharedFields"
             xmlns:loc="using:Collectary.Presentation.Localization"
             xmlns:controls="using:Collectary.UI.Controls"
             x:Class="Collectary.UI.Views.SharedFields.SharedFieldLibraryView"
             x:DataType="sf:SharedFieldLibraryViewModel">

    <UserControl.Styles>
        <Style Selector="Border.dragging">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BoxShadow" Value="0 6 16 0 #50000000"/>
            <Setter Property="ZIndex" Value="1"/>
            <Setter Property="RenderTransform" Value="scale(1.01)"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Margin="16">

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="{Binding [SharedFields], Source={x:Static loc:LocalizationService.Instance}}"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="{Binding [SharedFieldsHint], Source={x:Static loc:LocalizationService.Instance}}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,4,0,0"
                       FontSize="13"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Master / detail split -->
        <Grid x:Name="SplitGrid" Grid.Row="1" RowDefinitions="*" ColumnDefinitions="240,Auto,*" Margin="0,8,0,0">

            <!-- Master: field list -->
            <Grid x:Name="MasterPane" Grid.Column="0" MinWidth="200" RowDefinitions="*,Auto"
                  IsVisible="{Binding IsMasterPanelVisible}">
                <Border Grid.Row="0"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                    <ListBox x:Name="FieldListBox"
                             ItemsSource="{Binding CurrentRows}"
                             SelectedItem="{Binding SelectedNode}"
                             Background="Transparent">
                        <ListBox.DataTemplates>
                            <DataTemplate DataType="vm:FieldDefinitionRowViewModel">
                                <Border Background="Transparent" Classes.dragging="{Binding IsDragging}">
                                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto">
                                    <TextBlock Grid.Column="0"
                                               Text="{x:Static icons:IconGlyphs.ReOrderDotsVertical}" Classes="icon"
                                               Tag="DragHandle"
                                               Background="Transparent"
                                               Cursor="SizeAll"
                                               IsVisible="{Binding CanDelete}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding TypeIcon}"
                                               Classes="icon"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <Grid Grid.Column="2" ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                                        <TextBlock Grid.Column="0" Text="{Binding LockGlyph}" Classes="icon"
                                                   VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding DisplayLabel}"
                                                   FontWeight="Medium"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Grid.Column="3"
                                               Text="●"
                                               FontSize="10"
                                               ToolTip.Tip="{Binding [Required], Source={x:Static loc:LocalizationService.Instance}}"
                                               IsVisible="{Binding IsRequired}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"
                                               Margin="4,0"/>
                                    <TextBlock Grid.Column="4"
                                               Text="{x:Static icons:IconGlyphs.ChevronRight}" Classes="icon"
                                               FontSize="16"
                                               IsVisible="{Binding IsDrillable}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"
                                               Margin="4,0"/>
                                    <Button Grid.Column="5"
                                            Content="{x:Static icons:IconGlyphs.Dismiss}" Classes="icon"
                                            IsVisible="{Binding CanDelete}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="6,2"
                                            Command="{Binding $parent[ListBox].((sf:SharedFieldLibraryViewModel)DataContext).RemoveFieldCommand}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                                </Border>
                            </DataTemplate>

                            <DataTemplate DataType="vm:FieldGroupRowViewModel">
                                <Border Background="Transparent" Classes.dragging="{Binding IsDragging}">
                                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                                    <TextBlock Grid.Column="0"
                                               Text="{x:Static icons:IconGlyphs.ReOrderDotsVertical}" Classes="icon"
                                               Tag="DragHandle"
                                               Background="Transparent"
                                               Cursor="SizeAll"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding TypeIcon}"
                                               Classes="icon"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding DisplayLabel}"
                                               FontWeight="Medium"
                                               FontStyle="Italic"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3"
                                               Text="{x:Static icons:IconGlyphs.ChevronRight}" Classes="icon"
                                               FontSize="16"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"
                                               Margin="4,0"/>
                                    <Button Grid.Column="4"
                                            Content="{x:Static icons:IconGlyphs.Dismiss}" Classes="icon"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="6,2"
                                            Command="{Binding $parent[ListBox].((sf:SharedFieldLibraryViewModel)DataContext).RemoveFieldCommand}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.DataTemplates>
                    </ListBox>
                </Border>

                <Button Grid.Row="1"
                        x:Name="AddFieldButton"
                        Content="{Binding [AddField], Source={x:Static loc:LocalizationService.Instance}}"
                        Padding="12,6"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Margin="0,8,0,0">
                    <Button.Flyout>
                        <MenuFlyout/>
                    </Button.Flyout>
                </Button>
            </Grid>

            <!-- Splitter -->
            <GridSplitter x:Name="PaneSplitter"
                          Grid.Column="1"
                          Width="6"
                          Margin="3,0"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          Background="{DynamicResource BorderBrush}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Cursor="SizeWestEast"/>

            <!-- Detail: field configuration -->
            <Border x:Name="DetailPane"
                    Grid.Column="2"
                    MinWidth="280"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="16,16,10,16"
                    IsVisible="{Binding IsDetailPanelVisible}">
                <Panel>

                    <!-- Empty state -->
                    <TextBlock Text="{Binding [SelectFieldHint], Source={x:Static loc:LocalizationService.Instance}}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               IsVisible="{Binding SelectedNode, Converter={x:Static ObjectConverters.IsNull}}"/>

                    <!-- Field config -->
                    <controls:FieldDetailEditor DataContext="{Binding SelectedFieldRow}"
                                                IsVisible="{Binding $parent[UserControl].((sf:SharedFieldLibraryViewModel)DataContext).SelectedFieldRow, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                DrillCommand="{Binding $parent[UserControl].((sf:SharedFieldLibraryViewModel)DataContext).DrillIntoCommand}"/>

                    <!-- Group config -->
                    <controls:GroupDetailEditor DataContext="{Binding SelectedGroupRow}"
                                                IsVisible="{Binding $parent[UserControl].((sf:SharedFieldLibraryViewModel)DataContext).SelectedGroupRow, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                DrillCommand="{Binding $parent[UserControl].((sf:SharedFieldLibraryViewModel)DataContext).DrillIntoCommand}"/>

                    </Panel>
            </Border>
        </Grid>

        <!-- Footer -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="0,16,0,0">
            <Button x:Name="BackButton"
                    Command="{Binding BackCommand}"
                    Background="{DynamicResource PrimaryBrush}"
                    Foreground="{DynamicResource PrimaryForegroundBrush}"
                    Padding="16,6">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="←" FontSize="16"/>
                    <TextBlock Text="{Binding [Back], Source={x:Static loc:LocalizationService.Instance}}"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding SaveCommand}"
                    Content="{Binding [Save], Source={x:Static loc:LocalizationService.Instance}}"
                    Padding="12,6"/>
            <Button Command="{Binding CancelCommand}"
                    Content="{Binding [Cancel], Source={x:Static loc:LocalizationService.Instance}}"
                    Padding="12,6"/>
        </StackPanel>

    </Grid>
</UserControl>
