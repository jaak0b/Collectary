<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Collectary.UI.ViewModels"
             xmlns:loc="using:Collectary.UI.Localization"
             x:Class="Collectary.UI.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <ScrollViewer>
        <StackPanel Spacing="28" Margin="24,20,24,24" MaxWidth="520" HorizontalAlignment="Left">

            <!-- Appearance -->
            <StackPanel Spacing="14">
                <TextBlock Text="APPEARANCE"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           LetterSpacing="1"/>
                <Grid ColumnDefinitions="140,*" VerticalAlignment="Center">
                    <TextBlock Grid.Column="0"
                               Text="{Binding [Theme_Label], Source={x:Static loc:LocalizationService.Instance}}"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Content="☀️ Light"
                                Command="{Binding SetThemeCommand}"
                                CommandParameter="Light"
                                Padding="14,6"/>
                        <Button Content="🌙 Dark"
                                Command="{Binding SetThemeCommand}"
                                CommandParameter="Dark"
                                Padding="14,6"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <Separator/>

            <!-- Language -->
            <StackPanel Spacing="14">
                <TextBlock Text="LANGUAGE"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           LetterSpacing="1"/>
                <Grid ColumnDefinitions="140,*">
                    <TextBlock Grid.Column="0"
                               Text="{Binding [Language], Source={x:Static loc:LocalizationService.Instance}}"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding LanguageOptions}"
                              SelectedItem="{Binding SelectedLanguage}"
                              DisplayMemberBinding="{Binding DisplayName}"
                              MinWidth="140"/>
                </Grid>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>

</UserControl>
