<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Collectary.Presentation.ViewModels"
             xmlns:loc="using:Collectary.Presentation.Localization"
             xmlns:controls="using:Collectary.UI.Controls"
             x:Class="Collectary.UI.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <ScrollViewer>
        <StackPanel Spacing="28" Margin="24,20,24,24" MaxWidth="520" HorizontalAlignment="Left">

            <!-- Appearance -->
            <StackPanel Spacing="14">
                <TextBlock Text="APPEARANCE"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           LetterSpacing="1"/>
                <Grid ColumnDefinitions="140,*" VerticalAlignment="Center">
                    <TextBlock Grid.Column="0"
                               Text="{Binding [Theme_Label], Source={x:Static loc:LocalizationService.Instance}}"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Content="☀️ Light"
                                Command="{Binding SetThemeCommand}"
                                CommandParameter="Light"
                                Padding="14,6"/>
                        <Button Content="🌙 Dark"
                                Command="{Binding SetThemeCommand}"
                                CommandParameter="Dark"
                                Padding="14,6"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <Separator/>

            <!-- Language -->
            <StackPanel Spacing="14">
                <TextBlock Text="LANGUAGE"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           LetterSpacing="1"/>
                <Grid ColumnDefinitions="140,*">
                    <TextBlock Grid.Column="0"
                               Text="{Binding [Language], Source={x:Static loc:LocalizationService.Instance}}"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding LanguageOptions}"
                              SelectedItem="{Binding SelectedLanguage}"
                              DisplayMemberBinding="{Binding DisplayName}"
                              MinWidth="140"/>
                </Grid>
            </StackPanel>

            <Separator/>

            <!-- Sync -->
            <StackPanel Spacing="14">
                <TextBlock Text="{Binding [Settings_Sync], Source={x:Static loc:LocalizationService.Instance}}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           LetterSpacing="1"/>

                <Grid ColumnDefinitions="140,*" VerticalAlignment="Center">
                    <TextBlock Grid.Column="0"
                               Text="{Binding [Sync_Location], Source={x:Static loc:LocalizationService.Instance}}"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock Text="{Binding SyncLocation}"
                                   IsVisible="{Binding IsSyncConfigured}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding [Sync_NotConfigured], Source={x:Static loc:LocalizationService.Instance}}"
                                   IsVisible="{Binding !IsSyncConfigured}"
                                   FontStyle="Italic"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="{Binding [Sync_ChooseFolder], Source={x:Static loc:LocalizationService.Instance}}"
                                    Command="{Binding ChooseSyncFolderCommand}"
                                    Padding="12,6"/>
                            <Button Content="{Binding [Sync_Disable], Source={x:Static loc:LocalizationService.Instance}}"
                                    Command="{Binding DisableSyncCommand}"
                                    IsVisible="{Binding IsSyncConfigured}"
                                    Padding="12,6"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <Grid ColumnDefinitions="140,*" IsVisible="{Binding IsSyncConfigured}">
                    <TextBlock Grid.Column="0"
                               Text="{Binding [Sync_AutoSync], Source={x:Static loc:LocalizationService.Instance}}"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <ToggleSwitch IsChecked="{Binding AutoSyncEnabled}"/>
                        <TextBlock Text="{Binding [Sync_IntervalMinutes], Source={x:Static loc:LocalizationService.Instance}}"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding AutoSyncEnabled}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <controls:SafeNumericUpDown Value="{Binding AutoSyncIntervalMinutes}"
                                       Minimum="1"
                                       Maximum="1440"
                                       Increment="1"
                                       FormatString="0"
                                       IsVisible="{Binding AutoSyncEnabled}"
                                       MinWidth="110"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>

</UserControl>
