<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Collectary.Presentation.ViewModels"
             xmlns:loc="using:Collectary.Presentation.Localization"
             xmlns:controls="using:Collectary.UI.Controls"
             xmlns:conv="using:Collectary.UI.Converters"
             xmlns:domain="using:Collectary.Core.Domain"
             x:Class="Collectary.UI.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <UserControl.Resources>
        <conv:CloudProviderDisplayConverter x:Key="ProviderConv"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="WrapPanel.buttons > Button">
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel Spacing="28" Margin="24,20,24,24" MaxWidth="520" HorizontalAlignment="Stretch"
                    Grid.IsSharedSizeScope="True">

            <!-- Appearance -->
            <StackPanel Spacing="14">
                <TextBlock Text="{Binding [Settings_Appearance], Source={x:Static loc:LocalizationService.Instance}}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           LetterSpacing="1"/>

                <controls:SettingsRow Label="{Binding [Appearance_Skin], Source={x:Static loc:LocalizationService.Instance}}">
                    <ComboBox ItemsSource="{Binding Skins}"
                              SelectedItem="{Binding SelectedSkin}"
                              DisplayMemberBinding="{Binding DisplayName}"
                              HorizontalAlignment="Stretch"/>
                </controls:SettingsRow>

                <controls:SettingsRow Label="{Binding [Appearance_ColorTheme], Source={x:Static loc:LocalizationService.Instance}}">
                    <ComboBox ItemsSource="{Binding ColorThemes}"
                              SelectedItem="{Binding SelectedColorTheme}"
                              DisplayMemberBinding="{Binding DisplayName}"
                              HorizontalAlignment="Stretch"/>
                </controls:SettingsRow>

                <TextBlock x:Name="CustomThemeBadge"
                           Text="{Binding CustomThemeLabel}"
                           IsVisible="{Binding HasCustomizations}"
                           FontSize="12"
                           FontStyle="Italic"
                           Foreground="{DynamicResource PrimaryBrush}"
                           Margin="0,-6,0,0"/>

                <controls:SettingsRow Label="{Binding [FieldLabel_Layout], Source={x:Static loc:LocalizationService.Instance}}">
                    <ComboBox ItemsSource="{Binding FieldLabelLayoutOptions}"
                              SelectedItem="{Binding SelectedFieldLabelLayout}"
                              DisplayMemberBinding="{Binding Display}"
                              HorizontalAlignment="Stretch"/>
                </controls:SettingsRow>

                <Expander Header="{Binding [Appearance_Customize], Source={x:Static loc:LocalizationService.Instance}}"
                          HorizontalAlignment="Stretch">
                    <StackPanel Spacing="14" Margin="0,8,0,0" Grid.IsSharedSizeScope="True">

                        <!-- Easy | Expert toggle -->
                        <WrapPanel>
                            <RadioButton GroupName="ColorMode" Margin="0,0,8,0"
                                         Content="{Binding [Appearance_EasyMode], Source={x:Static loc:LocalizationService.Instance}}"
                                         IsChecked="{Binding !ExpertColorMode}"/>
                            <RadioButton GroupName="ColorMode"
                                         Content="{Binding [Appearance_ExpertMode], Source={x:Static loc:LocalizationService.Instance}}"
                                         IsChecked="{Binding ExpertColorMode}"/>
                        </WrapPanel>

                        <!-- Accent (Easy mode only — auto-derives button states) -->
                        <controls:SettingsRow Label="{Binding [Color_Accent], Source={x:Static loc:LocalizationService.Instance}}"
                                              IsVisible="{Binding !ExpertColorMode}">
                            <WrapPanel Classes="buttons">
                                <ColorPicker Color="{Binding AccentColor}" Margin="0,0,8,8"/>
                                <Button Content="{Binding [Appearance_ResetAccent], Source={x:Static loc:LocalizationService.Instance}}"
                                        Command="{Binding ResetAccentCommand}"
                                        IsVisible="{Binding HasCustomAccent}"
                                        Padding="12,6"/>
                            </WrapPanel>
                        </controls:SettingsRow>

                        <!-- Per-color pickers (Easy shows essentials, Expert shows all) -->
                        <ItemsControl ItemsSource="{Binding ColorSlots}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CustomColorSlot">
                                    <controls:SettingsRow Label="{Binding Label}"
                                                          Margin="0,0,0,8"
                                                          IsVisible="{Binding IsRowVisible}">
                                        <ColorPicker HorizontalAlignment="Left"
                                                     Color="{Binding Color}"/>
                                    </controls:SettingsRow>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Content="{Binding [Appearance_ResetColors], Source={x:Static loc:LocalizationService.Instance}}"
                                Command="{Binding ResetColorsCommand}"
                                HorizontalAlignment="Left"
                                Padding="12,6"/>
                    </StackPanel>
                </Expander>
            </StackPanel>

            <Separator IsVisible="{Binding ShowAudioSettings}"/>

            <!-- Audio -->
            <StackPanel Spacing="14" IsVisible="{Binding ShowAudioSettings}">
                <TextBlock Text="{Binding [Settings_Audio], Source={x:Static loc:LocalizationService.Instance}}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           LetterSpacing="1"/>

                <controls:SettingsRow Label="{Binding [Audio_Microphone], Source={x:Static loc:LocalizationService.Instance}}">
                    <ComboBox ItemsSource="{Binding InputDevices}"
                              SelectedItem="{Binding SelectedInputDevice}"
                              DisplayMemberBinding="{Binding Name}"
                              HorizontalAlignment="Stretch"/>
                </controls:SettingsRow>

                <controls:SettingsRow Label="{Binding [Audio_PlaybackDevice], Source={x:Static loc:LocalizationService.Instance}}">
                    <ComboBox ItemsSource="{Binding OutputDevices}"
                              SelectedItem="{Binding SelectedOutputDevice}"
                              DisplayMemberBinding="{Binding Name}"
                              HorizontalAlignment="Stretch"/>
                </controls:SettingsRow>
            </StackPanel>

            <Separator/>

            <!-- Language -->
            <StackPanel Spacing="14">
                <TextBlock Text="{Binding [Settings_Language], Source={x:Static loc:LocalizationService.Instance}}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           LetterSpacing="1"/>
                <controls:SettingsRow Label="{Binding [Language], Source={x:Static loc:LocalizationService.Instance}}">
                    <ComboBox ItemsSource="{Binding LanguageOptions}"
                              SelectedItem="{Binding SelectedLanguage}"
                              DisplayMemberBinding="{Binding DisplayName}"
                              HorizontalAlignment="Stretch"/>
                </controls:SettingsRow>
            </StackPanel>

            <Separator/>

            <!-- Sync -->
            <StackPanel Spacing="14">
                <TextBlock Text="{Binding [Settings_Sync], Source={x:Static loc:LocalizationService.Instance}}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           LetterSpacing="1"/>

                <!-- Storage provider -->
                <controls:SettingsRow Label="{Binding [Settings_SyncProvider], Source={x:Static loc:LocalizationService.Instance}}">
                    <ComboBox ItemsSource="{Binding ProviderOptions}"
                              SelectedItem="{Binding SyncProvider}"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="domain:CloudProvider">
                                <TextBlock Text="{Binding Converter={StaticResource ProviderConv}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </controls:SettingsRow>

                <!-- Folder provider -->
                <controls:SettingsRow Label="{Binding [Sync_Location], Source={x:Static loc:LocalizationService.Instance}}"
                                      IsVisible="{Binding !IsCloudProvider}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding SyncLocation}"
                                   IsVisible="{Binding IsSyncConfigured}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding [Sync_NotConfigured], Source={x:Static loc:LocalizationService.Instance}}"
                                   IsVisible="{Binding !IsSyncConfigured}"
                                   FontStyle="Italic"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <WrapPanel Classes="buttons">
                            <Button Content="{Binding [Sync_ChooseFolder], Source={x:Static loc:LocalizationService.Instance}}"
                                    Command="{Binding ChooseSyncFolderCommand}"
                                    Padding="12,6"/>
                            <Button Content="{Binding [Cloud_AutoDetectFolder], Source={x:Static loc:LocalizationService.Instance}}"
                                    Command="{Binding AutoDetectLocalCloudFolderCommand}"
                                    Padding="12,6"/>
                            <Button Content="{Binding [Sync_Disable], Source={x:Static loc:LocalizationService.Instance}}"
                                    Command="{Binding DisableSyncCommand}"
                                    IsVisible="{Binding IsSyncConfigured}"
                                    Padding="12,6"/>
                        </WrapPanel>
                    </StackPanel>
                </controls:SettingsRow>

                <!-- Cloud provider -->
                <controls:SettingsRow Label="{Binding [Settings_SyncProvider], Source={x:Static loc:LocalizationService.Instance}}"
                                      IsVisible="{Binding IsCloudProvider}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding ConnectionStatus}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <StackPanel Orientation="Horizontal" Spacing="6"
                                    IsVisible="{Binding IsCloudFolderChosen}">
                            <TextBlock Text="{Binding [Cloud_SyncFolder], Source={x:Static loc:LocalizationService.Instance}}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding SelectedFolderName}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <WrapPanel Classes="buttons">
                            <Button Content="{Binding [Cloud_Connect], Source={x:Static loc:LocalizationService.Instance}}"
                                    Command="{Binding ConnectCommand}"
                                    IsVisible="{Binding !IsCloudConnected}"
                                    Padding="12,6"/>
                            <Button Content="{Binding [Cloud_ChooseFolder], Source={x:Static loc:LocalizationService.Instance}}"
                                    Command="{Binding ChooseCloudFolderCommand}"
                                    IsVisible="{Binding IsCloudConnected}"
                                    Padding="12,6"/>
                            <Button Content="{Binding [Cloud_Disconnect], Source={x:Static loc:LocalizationService.Instance}}"
                                    Command="{Binding DisconnectCommand}"
                                    IsVisible="{Binding IsCloudConnected}"
                                    Padding="12,6"/>
                        </WrapPanel>
                    </StackPanel>
                </controls:SettingsRow>

                <controls:SettingsRow Label="{Binding [Sync_AutoSync], Source={x:Static loc:LocalizationService.Instance}}"
                                      IsVisible="{Binding IsSyncConfigured}">
                    <WrapPanel VerticalAlignment="Center">
                        <ToggleSwitch IsChecked="{Binding AutoSyncEnabled}" Margin="0,0,12,0"/>
                        <TextBlock Text="{Binding [Sync_IntervalMinutes], Source={x:Static loc:LocalizationService.Instance}}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"
                                   IsVisible="{Binding AutoSyncEnabled}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <controls:SafeNumericUpDown Value="{Binding AutoSyncIntervalMinutes}"
                                       Minimum="1"
                                       Maximum="1440"
                                       Increment="1"
                                       FormatString="0"
                                       IsVisible="{Binding AutoSyncEnabled}"
                                       MinWidth="110"/>
                    </WrapPanel>
                </controls:SettingsRow>
            </StackPanel>

            <Separator/>

            <StackPanel Spacing="14">
                <TextBlock Text="{Binding [Backup_Title], Source={x:Static loc:LocalizationService.Instance}}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           LetterSpacing="1"/>

                <TextBlock Text="{Binding [Backup_Hint], Source={x:Static loc:LocalizationService.Instance}}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>

                <WrapPanel Classes="buttons">
                    <Button Content="{Binding [Backup_Export], Source={x:Static loc:LocalizationService.Instance}}"
                            Command="{Binding ExportBackupCommand}"
                            Padding="12,6"/>
                    <Button Content="{Binding [Backup_Import], Source={x:Static loc:LocalizationService.Instance}}"
                            Command="{Binding ImportBackupCommand}"
                            Padding="12,6"/>
                </WrapPanel>

                <TextBlock Text="{Binding BackupStatus}"
                           IsVisible="{Binding BackupStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
            </StackPanel>

            <Separator/>

            <StackPanel Spacing="14">
                <TextBlock Text="{Binding [Settings_Account], Source={x:Static loc:LocalizationService.Instance}}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           LetterSpacing="1"/>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="{Binding [Profile_Switch], Source={x:Static loc:LocalizationService.Instance}}"
                            Command="{Binding SwitchProfileCommand}"
                            Padding="12,6"/>

                    <Button Content="{Binding [Profile_Delete], Source={x:Static loc:LocalizationService.Instance}}"
                            Command="{Binding DeleteProfileCommand}"
                            Padding="12,6"
                            Background="Transparent"
                            Foreground="{DynamicResource DangerBrush}"
                            BorderBrush="{DynamicResource DangerBrush}"/>
                </StackPanel>
            </StackPanel>

            <Separator/>

            <StackPanel Spacing="14">
                <TextBlock Text="{Binding [Settings_About], Source={x:Static loc:LocalizationService.Instance}}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           LetterSpacing="1"/>

                <controls:SettingsRow Label="{Binding [About_Version], Source={x:Static loc:LocalizationService.Instance}}">
                    <TextBlock x:Name="AppVersionText"
                               Text="{Binding AppVersion}"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </controls:SettingsRow>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>

</UserControl>
