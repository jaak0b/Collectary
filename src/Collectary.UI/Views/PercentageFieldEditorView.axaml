<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Collectary.UI.Controls"
             xmlns:vm="using:Collectary.Presentation.ViewModels"
             x:Class="Collectary.UI.Views.PercentageFieldEditorView"
             x:DataType="vm:PercentageFieldEditorViewModel">

    <controls:FieldEditorScaffold Label="{Binding Definition.Label}"
                                  IsRequired="{Binding Definition.IsRequired}"
                                  LabelAbove="{Binding LabelAbove}">
        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Top">
            <controls:SafeNumericUpDown Value="{Binding Number}"
                           Minimum="0"
                           Maximum="100"
                           FormatString="0.#"
                           Increment="1"
                           MinWidth="100"
                           HorizontalAlignment="Left"/>
            <TextBlock Text="%"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>
    </controls:FieldEditorScaffold>
</UserControl>
