<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Collectary.UI.Controls"
             xmlns:vm="using:Collectary.Presentation.ViewModels"
             x:Class="Collectary.UI.Views.UrlFieldEditorView"
             x:DataType="vm:UrlFieldEditorViewModel">

    <controls:FieldEditorScaffold Label="{Binding Definition.Label}"
                                  IsRequired="{Binding Definition.IsRequired}"
                                  LabelAbove="{Binding LabelAbove}">
        <TextBox Text="{Binding Url}"
                 PlaceholderText="https://"
                 VerticalAlignment="Top"/>
    </controls:FieldEditorScaffold>
</UserControl>
