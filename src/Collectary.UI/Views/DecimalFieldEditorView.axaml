<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Collectary.UI.ViewModels"
             x:Class="Collectary.UI.Views.DecimalFieldEditorView"
             x:DataType="vm:DecimalFieldEditorViewModel">

    <StackPanel Spacing="4">
        <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock Text="{Binding Definition.Label}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       VerticalAlignment="Center"/>
            <TextBlock Text="*"
                       Foreground="Red"
                       IsVisible="{Binding Definition.IsRequired}"
                       VerticalAlignment="Center"/>
        </StackPanel>
        <NumericUpDown Value="{Binding Number}"
                       FormatString="0.##"
                       Increment="0.1"
                       HorizontalAlignment="Left"
                       MinWidth="120"/>
    </StackPanel>
</UserControl>
