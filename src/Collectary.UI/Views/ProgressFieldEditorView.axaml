<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Collectary.UI.Controls"
             xmlns:vm="using:Collectary.Presentation.ViewModels"
             x:Class="Collectary.UI.Views.ProgressFieldEditorView"
             x:DataType="vm:ProgressFieldEditorViewModel">

    <controls:FieldEditorScaffold Label="{Binding Definition.Label}"
                                  IsRequired="{Binding Definition.IsRequired}"
                                  LabelAbove="{Binding LabelAbove}">
        <StackPanel Spacing="6" VerticalAlignment="Top">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <controls:SafeNumericUpDown Value="{Binding Have}" Minimum="0" Maximum="9999999" MinWidth="100"/>
                <TextBlock Text="/" VerticalAlignment="Center"/>
                <controls:SafeNumericUpDown Value="{Binding Total}" Minimum="0" Maximum="9999999" MinWidth="100"/>
                <TextBlock Text="{Binding Percent, StringFormat={}{0}%}" VerticalAlignment="Center" MinWidth="44"/>
            </StackPanel>
            <ProgressBar Minimum="0" Maximum="1" Value="{Binding Fraction}" Height="8"/>
        </StackPanel>
    </controls:FieldEditorScaffold>
</UserControl>
