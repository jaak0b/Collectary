<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Collectary.UI.Controls"
             xmlns:vm="using:Collectary.Presentation.ViewModels"
             x:Class="Collectary.UI.Views.DateFieldEditorView"
             x:DataType="vm:DateFieldEditorViewModel">

    <controls:FieldEditorScaffold Label="{Binding Definition.Label}"
                                  IsRequired="{Binding Definition.IsRequired}"
                                  LabelAbove="{Binding LabelAbove}">
        <CalendarDatePicker SelectedDate="{Binding Date, Mode=TwoWay}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            MinWidth="160"/>
    </controls:FieldEditorScaffold>
</UserControl>
