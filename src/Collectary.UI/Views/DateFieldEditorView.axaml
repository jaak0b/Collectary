<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Collectary.UI.Controls"
             xmlns:vm="using:Collectary.Presentation.ViewModels"
             x:Class="Collectary.UI.Views.DateFieldEditorView"
             x:DataType="vm:DateFieldEditorViewModel">

    <controls:FieldEditorScaffold Label="{Binding Definition.Label}"
                                  IsRequired="{Binding Definition.IsRequired}"
                                  LabelAbove="{Binding LabelAbove}">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Top" HorizontalAlignment="Left">
            <controls:DatePickerBox SelectedDate="{Binding Date, Mode=TwoWay}"
                                    MinWidth="160"/>
            <controls:TimeClockBox Time="{Binding Time, Mode=TwoWay}"
                                   IsVisible="{Binding WithTime}"
                                   MinWidth="96"/>
        </StackPanel>
    </controls:FieldEditorScaffold>
</UserControl>
