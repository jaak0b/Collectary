<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Collectary.UI.ViewModels"
             x:Class="Collectary.UI.Views.BoolFieldEditorView"
             x:DataType="vm:BoolFieldEditorViewModel">

    <StackPanel Orientation="Horizontal" Spacing="8">
        <CheckBox IsChecked="{Binding IsChecked}"/>
        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
            <TextBlock Text="{Binding Definition.Label}"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBlock Text="*"
                       Foreground="Red"
                       IsVisible="{Binding Definition.IsRequired}"/>
        </StackPanel>
    </StackPanel>
</UserControl>
