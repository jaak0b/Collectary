<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Collectary.UI.Controls"
             xmlns:vm="using:Collectary.Presentation.ViewModels"
             x:Class="Collectary.UI.Views.DisplayNameFieldEditorView"
             x:DataType="vm:DisplayNameFieldEditorViewModel">

    <controls:FieldEditorScaffold Label="{Binding Label}"
                                  IsRequired="{Binding Definition.IsRequired}"
                                  LabelAbove="{Binding LabelAbove}">
        <TextBox Text="{Binding Text}"
                 PlaceholderText="{Binding Label}"
                 VerticalAlignment="Top"/>
    </controls:FieldEditorScaffold>
</UserControl>
