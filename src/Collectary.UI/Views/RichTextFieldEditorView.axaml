<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Collectary.UI.Controls"
             xmlns:vm="using:Collectary.Presentation.ViewModels"
             x:Class="Collectary.UI.Views.RichTextFieldEditorView"
             x:DataType="vm:RichTextFieldEditorViewModel">

    <controls:FieldEditorScaffold Label="{Binding Definition.Label}"
                                  IsRequired="{Binding Definition.IsRequired}"
                                  LabelAbove="{Binding LabelAbove}">
        <TextBox Text="{Binding Markdown}"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 MinHeight="120"
                 FontFamily="Cascadia Code,Consolas,monospace"
                 PlaceholderText="{Binding Definition.Label}"
                 VerticalAlignment="Top"/>
    </controls:FieldEditorScaffold>
</UserControl>
