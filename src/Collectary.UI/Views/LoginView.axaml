<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Collectary.Presentation.ViewModels"
             xmlns:loc="using:Collectary.Presentation.Localization"
             x:Class="Collectary.UI.Views.LoginView"
             x:DataType="vm:LoginViewModel"
             Background="{DynamicResource BackgroundBrush}">

    <StackPanel Margin="28"
                Spacing="12"
                Width="380"
                MaxWidth="380"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

        <TextBlock Text="{Binding Title}"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}"/>

        <TextBox Text="{Binding Username}"
                 Watermark="{Binding [Login_Username], Source={x:Static loc:LocalizationService.Instance}}"/>

        <TextBox Text="{Binding DisplayName}"
                 IsVisible="{Binding IsRegisterMode}"
                 Watermark="{Binding [Login_DisplayName], Source={x:Static loc:LocalizationService.Instance}}"/>

        <TextBox Text="{Binding Email}"
                 IsVisible="{Binding IsRegisterMode}"
                 Watermark="{Binding [Login_Email], Source={x:Static loc:LocalizationService.Instance}}"/>

        <TextBox Text="{Binding Password}"
                 PasswordChar="•"
                 Watermark="{Binding [Login_Password], Source={x:Static loc:LocalizationService.Instance}}"/>

        <TextBlock Text="{Binding ErrorMessage}"
                   Foreground="{DynamicResource DangerBrush}"
                   IsVisible="{Binding HasError}"
                   TextWrapping="Wrap"/>

        <Button Content="{Binding SubmitLabel}"
                Command="{Binding SubmitCommand}"
                IsEnabled="{Binding !IsBusy}"
                IsDefault="True"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Padding="12,8"
                Background="{DynamicResource PrimaryBrush}"
                Foreground="{DynamicResource PrimaryForegroundBrush}"/>

        <Button Content="{Binding ToggleLabel}"
                Command="{Binding ToggleModeCommand}"
                Background="Transparent"
                BorderThickness="0"
                HorizontalAlignment="Center"
                Foreground="{DynamicResource TextSecondaryBrush}"/>

    </StackPanel>
</UserControl>
