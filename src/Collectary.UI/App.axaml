<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Collectary.UI"
             xmlns:vm="using:Collectary.Presentation.ViewModels"
             xmlns:controls="using:Collectary.UI.Controls"
             x:Class="Collectary.UI.App"
             RequestedThemeVariant="Light">

    <Application.DataTemplates>

        <DataTemplate DataType="vm:FieldGroupViewModel">
            <Expander Header="{Binding Name}"
                      IsExpanded="{Binding IsExpanded}"
                      HorizontalAlignment="Stretch"
                      Margin="0,4">
                <StackPanel Spacing="4">
                    <ItemsControl ItemsSource="{Binding Editors}" Grid.IsSharedSizeScope="True">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:FieldGridPanel ColumnCount="{Binding ColumnCount}" MinColumnWidth="200"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ContentControl Content="{Binding}" Margin="0,4"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding ChildRegions}"/>
                </StackPanel>
            </Expander>
        </DataTemplate>

        <DataTemplate DataType="vm:TabRegionViewModel">
            <Panel Margin="0,4">
                <TabControl ItemsSource="{Binding TabGroups}"
                            IsVisible="{Binding !Context.IsNarrow}">
                    <TabControl.ItemTemplate>
                        <DataTemplate DataType="vm:FieldGroupViewModel">
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </TabControl.ItemTemplate>
                    <TabControl.ContentTemplate>
                        <DataTemplate DataType="vm:FieldGroupViewModel">
                            <StackPanel Spacing="4" Margin="0,8,0,0">
                                <ItemsControl ItemsSource="{Binding Editors}" Grid.IsSharedSizeScope="True">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <controls:FieldGridPanel ColumnCount="{Binding ColumnCount}" MinColumnWidth="200"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ContentControl Content="{Binding}" Margin="0,4"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl ItemsSource="{Binding ChildRegions}"/>
                            </StackPanel>
                        </DataTemplate>
                    </TabControl.ContentTemplate>
                </TabControl>

                <ItemsControl ItemsSource="{Binding TabGroups}"
                              IsVisible="{Binding Context.IsNarrow}"/>
            </Panel>
        </DataTemplate>

        <local:ViewLocator/>

    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Collectary.UI/Themes/Colors.Light.axaml"/>
                <ResourceInclude Source="avares://Collectary.UI/Controls/FieldEditorScaffold.axaml"/>
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="CalendarViewForeground" Color="{DynamicResource TextPrimaryColor}"/>
            <SolidColorBrush x:Key="CalendarViewBackground" Color="{DynamicResource SurfaceColor}"/>
            <SolidColorBrush x:Key="CalendarViewBorderBrush" Color="{DynamicResource BorderColor}"/>
            <SolidColorBrush x:Key="CalendarViewCalendarItemForeground" Color="{DynamicResource TextPrimaryColor}"/>
            <SolidColorBrush x:Key="CalendarViewCalendarItemRevealBackground" Color="Transparent"/>
            <SolidColorBrush x:Key="CalendarViewCalendarItemRevealBorderBrush" Color="Transparent"/>
            <SolidColorBrush x:Key="CalendarViewHoverBorderBrush" Color="{DynamicResource PrimaryColor}"/>
            <SolidColorBrush x:Key="CalendarViewSelectedBorderBrush" Color="{DynamicResource PrimaryColor}"/>
            <SolidColorBrush x:Key="CalendarViewTodayForeground" Color="{DynamicResource PrimaryForegroundColor}"/>
            <SolidColorBrush x:Key="CalendarViewOutOfScopeForeground" Color="{DynamicResource TextSecondaryColor}"/>
            <SolidColorBrush x:Key="CalendarViewOutOfScopeBackground" Color="Transparent"/>
            <SolidColorBrush x:Key="CalendarViewBlackoutForeground" Color="{DynamicResource TextSecondaryColor}"/>
            <SolidColorBrush x:Key="CalendarViewWeekDayForegroundDisabled" Color="{DynamicResource TextSecondaryColor}"/>
            <SolidColorBrush x:Key="CalendarViewNavigationButtonBackground" Color="Transparent"/>
            <SolidColorBrush x:Key="CalendarViewNavigationButtonBorderBrush" Color="Transparent"/>
            <SolidColorBrush x:Key="CalendarViewNavigationButtonBorderBrushPointerOver" Color="{DynamicResource BorderColor}"/>
            <SolidColorBrush x:Key="CalendarViewNavigationButtonForegroundPointerOver" Color="{DynamicResource TextPrimaryColor}"/>
            <SolidColorBrush x:Key="CalendarViewNavigationButtonForegroundPressed" Color="{DynamicResource TextSecondaryColor}"/>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
        <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml"/>
        <Style Selector="TextBlock.icon">
            <Setter Property="FontFamily" Value="avares://Collectary.UI/Assets/Fonts/CollectaryIcons.ttf#CollectaryIcons"/>
        </Style>
        <Style Selector="Button.icon">
            <Setter Property="FontFamily" Value="avares://Collectary.UI/Assets/Fonts/CollectaryIcons.ttf#CollectaryIcons"/>
        </Style>
        <Style Selector="TextBox.fieldError">
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Application.Styles>
</Application>
