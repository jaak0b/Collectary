<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="using:Collectary.Core.Domain.Fields"
             xmlns:vm="using:Collectary.Presentation.ViewModels"
             x:Class="Collectary.UI.Controls.EditorBreadcrumb"
             x:DataType="vm:FieldListEditorViewModel">

    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="12,6">
        <ItemsControl ItemsSource="{Binding Levels}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:EditorLevel">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{x:Static icons:IconGlyphs.ChevronRight}" Classes="icon"
                                   Margin="4,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <Button Content="{Binding Title}"
                                IsVisible="{Binding !IsCurrent}"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="2,0"
                                Command="{Binding $parent[ItemsControl].((vm:FieldListEditorViewModel)DataContext).NavigateToLevelCommand}"
                                CommandParameter="{Binding}"/>
                        <TextBlock Text="{Binding Title}"
                                   IsVisible="{Binding IsCurrent}"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"
                                   Padding="2,0"/>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Border>
</UserControl>
