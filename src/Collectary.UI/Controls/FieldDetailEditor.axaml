<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="using:Collectary.Core.Domain.Fields"
             xmlns:vm="using:Collectary.Presentation.ViewModels"
             xmlns:loc="using:Collectary.Presentation.Localization"
             xmlns:converters="using:Collectary.Presentation.Converters"
             xmlns:controls="using:Collectary.UI.Controls"
             x:Class="Collectary.UI.Controls.FieldDetailEditor"
             x:DataType="vm:FieldDefinitionRowViewModel">

    <ScrollViewer>
        <StackPanel Spacing="12">

            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding TypeIcon}"
                           Classes="icon" FontSize="16" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding [FieldSettings], Source={x:Static loc:LocalizationService.Instance}}"
                           FontWeight="SemiBold"
                           FontSize="15"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{Binding TypeDisplayName}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- ── Field section ── -->
            <TextBlock Text="{Binding [SectionField], Source={x:Static loc:LocalizationService.Instance}}"
                       FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,4,0,0"/>
            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,0"/>

            <!-- Label -->
            <StackPanel Spacing="4">
                <TextBlock Text="{Binding [Name], Source={x:Static loc:LocalizationService.Instance}}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="12"/>
                <TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="{Binding [FieldLabelWatermark], Source={x:Static loc:LocalizationService.Instance}}"
                         IsVisible="{Binding IsLabelEditable}"/>
                <StackPanel Orientation="Horizontal" Spacing="4"
                            IsVisible="{Binding !IsLabelEditable}">
                    <TextBlock Text="{Binding LockGlyph}" Classes="icon" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding DisplayLabel}"
                               FontWeight="Medium"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <!-- Flags -->
            <StackPanel Orientation="Horizontal" Spacing="16">
                <CheckBox IsChecked="{Binding IsRequired}"
                          Content="{Binding [Required], Source={x:Static loc:LocalizationService.Instance}}"/>
                <CheckBox IsChecked="{Binding ShowInList}"
                          Content="{Binding [InList], Source={x:Static loc:LocalizationService.Instance}}"
                          IsVisible="{Binding ShowInListCheckboxVisible}"/>
            </StackPanel>

            <!-- Field width (hidden only when explicitly in a single-column group) -->
            <StackPanel IsVisible="{Binding IsInMultiColumnContext}" Spacing="4">
                <TextBlock Text="{Binding [FieldWidth], Source={x:Static loc:LocalizationService.Instance}}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="12"/>
                <ComboBox ItemsSource="{Binding ColumnSpanOptions}"
                          SelectedItem="{Binding ColumnSpan}"
                          MinWidth="120">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="x:Int32">
                            <TextBlock Text="{Binding Converter={x:Static converters:ColumnSpanConverter.Instance}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <!-- Group assignment -->
            <StackPanel IsVisible="{Binding HasAvailableGroups}" Spacing="4">
                <TextBlock Text="{Binding [Group], Source={x:Static loc:LocalizationService.Instance}}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="12"/>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <ComboBox Grid.Column="0"
                              ItemsSource="{Binding AvailableGroups}"
                              SelectedItem="{Binding SelectedGroup}"
                              HorizontalAlignment="Stretch"
                              PlaceholderText="{Binding [Ungrouped], Source={x:Static loc:LocalizationService.Instance}}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:FieldGroupRowViewModel">
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Grid.Column="1"
                            Content="{x:Static icons:IconGlyphs.Dismiss}" Classes="icon"
                            Padding="6,2"
                            Command="{Binding ClearGroupCommand}"/>
                </Grid>
            </StackPanel>

            <!-- ── Type settings section ── -->
            <StackPanel IsVisible="{Binding HasTypeSettings}" Spacing="0">
                <TextBlock Text="{Binding [SectionTypeSettings], Source={x:Static loc:LocalizationService.Instance}}"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,8,0,4"/>
                <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,12"/>

                <StackPanel Spacing="12">

                    <!-- Currency symbol -->
                    <StackPanel IsVisible="{Binding IsCurrency}" Spacing="4">
                        <TextBlock Text="{Binding [CurrencySymbol], Source={x:Static loc:LocalizationService.Instance}}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="12"/>
                        <TextBox Text="{Binding CurrencySymbol}"
                                 MaxLength="4"
                                 MinWidth="80"
                                 HorizontalAlignment="Left"/>
                    </StackPanel>

                    <!-- Text max length -->
                    <StackPanel IsVisible="{Binding IsText}" Spacing="4">
                        <TextBlock Text="{Binding [MaxLength], Source={x:Static loc:LocalizationService.Instance}}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="12"/>
                        <controls:SafeNumericUpDown Value="{Binding MaxLength}"
                                       Minimum="0"
                                       Maximum="100000"
                                       Increment="1"
                                       FormatString="0"
                                       HorizontalAlignment="Left"
                                       MinWidth="120"/>
                    </StackPanel>

                    <!-- Integer min / max -->
                    <Grid IsVisible="{Binding IsInteger}" ColumnDefinitions="*,*" ColumnSpacing="12">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="{Binding [MinValue], Source={x:Static loc:LocalizationService.Instance}}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="12"/>
                            <controls:SafeNumericUpDown Value="{Binding Min}" Increment="1" FormatString="0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="{Binding [MaxValue], Source={x:Static loc:LocalizationService.Instance}}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="12"/>
                            <controls:SafeNumericUpDown Value="{Binding Max}" Increment="1" FormatString="0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Decimal places -->
                    <StackPanel IsVisible="{Binding IsDecimal}" Spacing="4">
                        <TextBlock Text="{Binding [DecimalPlaces], Source={x:Static loc:LocalizationService.Instance}}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="12"/>
                        <controls:SafeNumericUpDown Value="{Binding DecimalPlaces}"
                                       Minimum="0"
                                       Maximum="10"
                                       Increment="1"
                                       FormatString="0"
                                       HorizontalAlignment="Left"
                                       MinWidth="120"/>
                    </StackPanel>

                    <!-- Bool answer mode -->
                    <StackPanel IsVisible="{Binding IsBool}" Spacing="4">
                        <CheckBox IsChecked="{Binding ThreeState}"
                                  Content="{Binding [AllowUnanswered], Source={x:Static loc:LocalizationService.Instance}}"/>
                    </StackPanel>

                    <!-- Color format -->
                    <StackPanel IsVisible="{Binding IsColor}" Spacing="4">
                        <TextBlock Text="{Binding [Format], Source={x:Static loc:LocalizationService.Instance}}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="12"/>
                        <ComboBox ItemsSource="{Binding ColorFormats}"
                                  SelectedItem="{Binding Format}"
                                  MinWidth="160"/>
                    </StackPanel>

                    <!-- Max stars (Rating) -->
                    <StackPanel IsVisible="{Binding IsRating}" Spacing="4">
                        <TextBlock Text="{Binding [MaxStars], Source={x:Static loc:LocalizationService.Instance}}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="12"/>
                        <controls:SafeNumericUpDown Value="{Binding MaxStars}"
                                       Minimum="1"
                                       Maximum="10"
                                       Increment="1"
                                       FormatString="0"
                                       HorizontalAlignment="Left"
                                       MinWidth="80"/>
                    </StackPanel>

                    <!-- Picture sizing -->
                    <StackPanel IsVisible="{Binding IsPicture}" Spacing="8">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding [SizeMode], Source={x:Static loc:LocalizationService.Instance}}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="12"/>
                            <ComboBox ItemsSource="{Binding ImageSizeModes}"
                                      SelectedItem="{Binding SizeMode}"
                                      MinWidth="160">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={x:Static converters:ImageSizeModeConverter.Instance}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="{Binding [DisplayWidth], Source={x:Static loc:LocalizationService.Instance}}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="12"/>
                                <controls:SafeNumericUpDown Value="{Binding DisplayWidth}" Minimum="50" Maximum="2000" Increment="1" FormatString="0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="{Binding [DisplayHeight], Source={x:Static loc:LocalizationService.Instance}}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="12"/>
                                <controls:SafeNumericUpDown Value="{Binding DisplayHeight}" Minimum="50" Maximum="2000" Increment="1" FormatString="0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Choices -->
                    <StackPanel IsVisible="{Binding HasChoices}" Spacing="4">
                        <TextBlock Text="{Binding [Options], Source={x:Static loc:LocalizationService.Instance}}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="12"/>
                        <ItemsControl ItemsSource="{Binding ChoiceItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ChoiceOptionRowViewModel">
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                        <TextBox Grid.Column="0"
                                                 Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                 PlaceholderText="{Binding [OptionLabelWatermark], Source={x:Static loc:LocalizationService.Instance}}"/>
                                        <Button Grid.Column="1"
                                                Content="{x:Static icons:IconGlyphs.Dismiss}" Classes="icon"
                                                Padding="6,2"
                                                Margin="4,0,0,0"
                                                Command="{Binding $parent[ItemsControl].((vm:FieldDefinitionRowViewModel)DataContext).RemoveChoiceCommand}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="{Binding [AddOption], Source={x:Static loc:LocalizationService.Instance}}"
                                Command="{Binding AddChoiceCommand}"
                                Padding="8,3"
                                Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- List config -->
                    <StackPanel IsVisible="{Binding IsList}" Spacing="8">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding [ColumnCount], Source={x:Static loc:LocalizationService.Instance}}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="12"/>
                            <controls:SafeNumericUpDown Value="{Binding ColumnCount}"
                                           Minimum="1"
                                           Maximum="24"
                                           Increment="1"
                                           FormatString="0"
                                           HorizontalAlignment="Left"
                                           MinWidth="80"/>
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding [InlineStyle], Source={x:Static loc:LocalizationService.Instance}}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="12"/>
                            <ComboBox ItemsSource="{Binding InlineStyles}"
                                      SelectedItem="{Binding InlineStyle}"
                                      MinWidth="160"/>
                        </StackPanel>
                        <Button Command="{Binding $parent[controls:FieldDetailEditor].DrillCommand}"
                                CommandParameter="{Binding}"
                                Padding="10,6"
                                HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding [ConfigureSubFields], Source={x:Static loc:LocalizationService.Instance}}"/>
                                <TextBlock Text="{Binding SubFieldCount, StringFormat='({0})'}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                </StackPanel>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
