<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ApplicationId>com.collectary.app</ApplicationId>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
  </PropertyGroup>

  <ItemGroup>
    <AndroidResource Include="Icon.png">
      <Link>Resources\drawable\Icon.png</Link>
    </AndroidResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" />
    <PackageReference Include="Microsoft.Identity.Client" />
    <PackageReference Include="Xamarin.AndroidX.Core.SplashScreen" />
    <PackageReference Include="Xamarin.AndroidX.Browser" />
    <PackageReference Include="Xamarin.AndroidX.Camera.Core" />
    <PackageReference Include="Xamarin.AndroidX.Camera.Camera2" />
    <PackageReference Include="Xamarin.AndroidX.Camera.Lifecycle" />
  </ItemGroup>

  <!-- The phone can't read the build machine's environment, so the public OneDrive client id and
       signing-certificate signature hash are compiled into the assembly from build env variables. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>CollectaryOneDriveClientId</_Parameter1>
      <_Parameter2>$(COLLECTARY_ONEDRIVE_CLIENT_ID)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>CollectaryAndroidSignatureHash</_Parameter1>
      <_Parameter2>$(COLLECTARY_ANDROID_SIGNATURE_HASH)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Collectary.UI\Collectary.UI.csproj" />
    <!-- Brings the OneDrive cloud-sync provider (MSAL/Graph). Because this head targets
         net10.0-android, NuGet resolves MSAL's Android asset (Chrome Custom Tabs, Keystore-backed
         token cache), even though the Cloud library itself is net8.0. -->
    <ProjectReference Include="..\Collectary.Infrastructure.Cloud\Collectary.Infrastructure.Cloud.csproj" />
  </ItemGroup>
</Project>
