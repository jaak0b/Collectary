<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Avalonia -->
    <PackageVersion Include="Avalonia" Version="12.0.4" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.0.4" />
    <PackageVersion Include="Avalonia.Android" Version="12.0.4" />
    <PackageVersion Include="Avalonia.Browser" Version="12.0.4" />
    <PackageVersion Include="Avalonia.Controls.DataGrid" Version="12.0.0" />
    <PackageVersion Include="Avalonia.Controls.ColorPicker" Version="12.0.4" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.0.4" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.0.4" />
    <PackageVersion Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- DI / MVVM -->
    <PackageVersion Include="Autofac" Version="8.*" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.*" />
    <PackageVersion Include="Mapster" Version="7.4.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- EF Core -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.*" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.*" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="9.0.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- Cloud sync (desktop-only: Collectary.Infrastructure.Cloud) -->
    <PackageVersion Include="Microsoft.Graph" Version="5.*" />
    <PackageVersion Include="Microsoft.Identity.Client" Version="4.*" />
    <PackageVersion Include="Microsoft.Identity.Client.Extensions.Msal" Version="4.*" />
    <PackageVersion Include="Google.Apis.Drive.v3" Version="1.*" />
    <PackageVersion Include="Google.Apis.Auth" Version="1.*" />
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="8.0.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- Barcode / QR decoding (snapshot scan) -->
    <PackageVersion Include="ZXing.Net" Version="0.16.*" />
    <PackageVersion Include="SkiaSharp" Version="3.119.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- Audio capture/playback (desktop-only: Collectary.UI.Desktop) -->
    <PackageVersion Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Webcam capture for live barcode scanning (desktop-only: Collectary.UI.Desktop) -->
    <PackageVersion Include="OpenCvSharp4.Windows" Version="4.10.0.20241108" />
  </ItemGroup>

  <ItemGroup>
    <!-- Spreadsheet import (.xlsx) -->
    <PackageVersion Include="ClosedXML" Version="0.104.*" />
    <!-- CSV import -->
    <PackageVersion Include="CsvHelper" Version="33.*" />
    <PackageVersion Include="System.Text.Encoding.CodePages" Version="8.0.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- Logging -->
    <PackageVersion Include="Serilog" Version="4.3.1" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageVersion Include="Serilog.Sinks.Debug" Version="3.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Android -->
    <PackageVersion Include="Xamarin.AndroidX.Core.SplashScreen" Version="1.0.1.17" />
    <!-- AndroidX Browser (Chrome Custom Tabs) — MSAL's interactive OneDrive sign-in activity loads it on resume (Android-only: Collectary.UI.Android) -->
    <PackageVersion Include="Xamarin.AndroidX.Browser" Version="1.8.0.11" />
    <!-- CameraX — live barcode scanning camera pipeline (Android-only: Collectary.UI.Android) -->
    <PackageVersion Include="Xamarin.AndroidX.Camera.Core" Version="1.6.1" />
    <PackageVersion Include="Xamarin.AndroidX.Camera.Camera2" Version="1.6.1" />
    <PackageVersion Include="Xamarin.AndroidX.Camera.Lifecycle" Version="1.6.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Testing -->
    <PackageVersion Include="Avalonia.Headless" Version="12.0.4" />
    <PackageVersion Include="Bogus" Version="35.6.5" />
    <PackageVersion Include="coverlet.collector" Version="6.0.0" />
    <PackageVersion Include="FakeItEasy" Version="9.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageVersion Include="NUnit" Version="3.14.0" />
    <PackageVersion Include="NUnit.Analyzers" Version="3.9.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="4.5.0" />
  </ItemGroup>
</Project>
